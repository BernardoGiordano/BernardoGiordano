{
  "name": "santella-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal site: projects, art, CV and blog, built on srl",
  "license": "MIT",
  "scripts": {
    "start": "srl serve --app web --open --proxy /api/=http://127.0.0.1:8001 --proxy /auth/=http://127.0.0.1:8001 --proxy /media/=http://127.0.0.1:8001 --proxy /feed.xml=http://127.0.0.1:8001 --proxy /sitemap.xml=http://127.0.0.1:8001 --proxy /robots.txt=http://127.0.0.1:8001",
    "serve": "srl serve --app web --proxy /api/=http://127.0.0.1:8001 --proxy /auth/=http://127.0.0.1:8001 --proxy /media/=http://127.0.0.1:8001 --proxy /feed.xml=http://127.0.0.1:8001 --proxy /sitemap.xml=http://127.0.0.1:8001 --proxy /robots.txt=http://127.0.0.1:8001",
    "build": "srl build --app web",
    "check": "srl check importmap --app web && srl check templates",
    "importmap": "srl check importmap --app web",
    "templates": "srl check templates",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "icons": "node tools/dev/icons.mjs",
    "vendor": "node tools/dev/vendor.mjs"
  },
  "dependencies": {
    "@srljs/core": "0.5.0",
    "dompurify": "3.4.14",
    "marked": "18.0.10"
  },
  "devDependencies": {
    "@srljs/cli": "0.5.0",
    "@tailwindcss/cli": "4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.3.0",
    "@web/test-runner": "^1.0.0",
    "esbuild": "0.28.2",
    "lucide-static": "1.33.0",
    "simple-icons": "16.28.0",
    "tailwindcss": "4.3.3"
  }
}
